# ===========================================
# Bridgemark Form Submission Configuration
# ===========================================
# Copy this file to `.env.local` and fill in your values.
# Never commit `.env.local` to version control.

# -------------------------------------------
# Google Sheets Integration
# -------------------------------------------
# Service Account email from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# Service Account private key (keep the quotes and \n for newlines)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# The ID of your Google Sheet (from the URL: https://docs.google.com/spreadsheets/d/SHEET_ID/edit)
GOOGLE_SHEET_ID=your-google-sheet-id-here

# -------------------------------------------
# Resend Email Service
# -------------------------------------------
# API Key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Email address to receive admin notifications
ADMIN_EMAIL=admin@yourdomain.com

# Sender email (must be verified in Resend)
# Use "onboarding@resend.dev" for testing
FROM_EMAIL=noreply@yourdomain.com